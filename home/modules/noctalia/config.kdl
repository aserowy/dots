prefer-no-csd
screenshot-path "~/pictures/%Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

input {
    focus-follows-mouse max-scroll-amount="25%"
    warp-mouse-to-focus

    keyboard {
        xkb {
            layout "us,de"
        }

        repeat-delay 600
        repeat-rate 25
        track-layout "global"
    }
}

output "HDMI-A-1" {
    transform "270"
}

layout {
    empty-workspace-above-first
    center-focused-column "never"
    default-column-width { proportion 0.33333; }
    gaps 16

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66666
        proportion 1.0
    }

    focus-ring {
        width 2
        active-color "#FFFFFF"
        inactive-color "#B9C0CA"
    }

    border {
        off
    }

    shadow {
        on
        softness 8
        spread 5
        offset x=3 y=3
        draw-behind-window true
        color "#272B3375"
        inactive-color "#272B3375"
    }

    tab-indicator {
        gaps-between-tabs 2
        place-within-column
    }

    struts {
        left 25
        right 50
    }
}

layer-rule {
  match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
  background-effect {
    blur true
    xray false
  }
}

window-rule {
    geometry-corner-radius 7
    clip-to-geometry true

    background-effect {
        blur true
        xray false
    }
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        off
    }

    border {
        on
        active-color "#FF936A"
        inactive-color "#FC2F52"
        width 2
    }

    tab-indicator {
        active-color "#FF936A"
        inactive-color "#FC2F52"
    }
}

debug {
  // Allows notification actions and window activation from Noctalia.
  honor-xdg-activation-with-invalid-serial
}

binds {
    Mod+B allow-inhibiting=false { spawn "brave"; }
    Mod+T allow-inhibiting=false { spawn "ghostty"; }
    Mod+E { spawn "ghostty" "-e" "yeet"; }

    Mod+Space allow-inhibiting=false { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+V { spawn  "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+S { spawn "noctalia" "msg" "panel-toggle" "control-center"; }

    XF86AudioRaiseVolume { spawn  "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume { spawn  "noctalia" "msg" "volume-down"; }
    XF86AudioMute { spawn  "noctalia" "msg" "volume-mute"; }

    XF86MonBrightnessUp { spawn  "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown { spawn  "noctalia" "msg" "brightness-down"; }

    Mod+A { spawn  "noctalia" "msg" "session" "lock"; }

    Mod+Shift+C allow-inhibiting=false { close-window; }

    Mod+H allow-inhibiting=false { focus-column-left; }
    Mod+J allow-inhibiting=false { focus-window-or-workspace-down; }
    Mod+K allow-inhibiting=false { focus-window-or-workspace-up; }
    Mod+L allow-inhibiting=false { focus-column-right; }

    Mod+Shift+H allow-inhibiting=false { move-column-left; }
    Mod+Shift+J allow-inhibiting=false { move-window-down-or-to-workspace-down; }
    Mod+Shift+K allow-inhibiting=false { move-window-up-or-to-workspace-up; }
    Mod+Shift+L allow-inhibiting=false { move-column-right; }

    Mod+Alt+Shift+J allow-inhibiting=false { move-workspace-down; }
    Mod+Alt+Shift+K allow-inhibiting=false { move-workspace-up; }

    Mod+Shift+U allow-inhibiting=false { consume-or-expel-window-left; }
    Mod+Shift+I allow-inhibiting=false { consume-or-expel-window-right; }
    Mod+Shift+G { toggle-column-tabbed-display; }

    Mod+N allow-inhibiting=false { focus-monitor-next; }
    Mod+P allow-inhibiting=false { focus-monitor-previous; }
    Mod+Shift+N allow-inhibiting=false { move-column-to-monitor-next; }
    Mod+Shift+P allow-inhibiting=false { move-column-to-monitor-previous; }

    Mod+O { toggle-overview; }
    Mod+Z { fullscreen-window; }

    Mod+Alt+Semicolon allow-inhibiting=false { switch-preset-column-width; }
    Mod+Alt+H allow-inhibiting=false { set-column-width "-10%"; }
    Mod+Alt+L allow-inhibiting=false { set-column-width "+10%"; }
    Mod+Alt+J allow-inhibiting=false { set-window-height "-10%"; }
    Mod+Alt+K allow-inhibiting=false { set-window-height "+10%"; }
}

environment {
    QT_QPA_PLATFORMTHEME "qt6ct"
    QT_QPA_PLATFORMTHEME_QT6 "qt6ct"
}

blur {
    passes 2
    offset 3.0
    noise 0.03
    saturation 1.0
}
